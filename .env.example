# Copiá a .env.local para desarrollo. Nunca subas un .env con valores reales.
# Frontend (Cloudflare Pages): URL pública del backend. NO es un secreto; no pongas claves acá:
# todo lo que empieza con VITE_ queda dentro del JavaScript publicado.
VITE_BACKEND_URL=

# Backend (Render): se configuran en el panel de Render, no en el repo.
# ALLOWED_ORIGINS=https://manhuua.pages.dev,https://*.manhuua.pages.dev
# RATE_LIMIT_PROXY=240        # peticiones por minuto por IP
# RATE_LIMIT_RENDER=12
# RENDER_CONCURRENCY=1        # navegadores a la vez (memoria)
# MAX_BYTES=26214400          # tamaño máximo por respuesta del proxy
# FETCH_TIMEOUT_MS=20000
# RENDER_TIMEOUT_MS=25000
# ALLOW_PRIVATE=false         # en producción se bloquean IPs internas
